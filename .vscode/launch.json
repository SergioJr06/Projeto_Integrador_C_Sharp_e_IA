{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (depurar)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/SafeGuardBackend/bin/Debug/net10.0/SafeGuardBackend.dll",
      "cwd": "${workspaceFolder}/SafeGuardBackend",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://localhost:5168" }
    },
    {
      "name": "Painel (depurar)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-painel",
      "program": "${workspaceFolder}/SafeGuardFrontend/bin/Debug/net10.0/SafeGuardFrontend.dll",
      "cwd": "${workspaceFolder}/SafeGuardFrontend",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://localhost:5080" }
    },
    {
      "name": "Motor de IA (Python)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/automacaototal.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    { "name": "API + Painel (depurar)", "configurations": ["API (depurar)", "Painel (depurar)"], "stopAll": true }
  ]
}
